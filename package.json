{
  "name": "aniverse-mobile",
  "version": "2.7.0",
  "private": true,
  "type": "module",
  "description": "AniVerse mobile website with a searchable catalog and episode-based personal library.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build-auth.mjs --require-tools && npm run build:frontend && node scripts/validate.mjs",
    "test": "node --test tests/*.test.js",
    "predev": "node scripts/build-auth.mjs && npm run build:frontend",
    "prestart": "node scripts/build-auth.mjs && npm run build:frontend",
    "check": "node scripts/doctor.mjs",
    "build:frontend": "node scripts/build-frontend.mjs && tailwindcss -i src/tailwind.css -o dist/tailwind.css --minify"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.1",
    "html-react-parser": "6.1.10",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@tailwindcss/cli": "4.3.5",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.5"
  }
}
